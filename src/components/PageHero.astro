---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-sand-200 bg-sand-100">
  <div class="container-page max-w-3xl py-14 sm:py-20">
    {
      eyebrow && (
        <p class="mb-3 text-sm font-semibold tracking-widest text-clay-600 uppercase">{eyebrow}</p>
      )
    }
    <h1 class="text-4xl font-semibold sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 text-lg text-ink-500 sm:text-xl">{intro}</p>}
  </div>
</section>
