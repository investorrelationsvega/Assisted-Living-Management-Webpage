---
import Logo from './Logo.astro';
import { SITE, NAV, CONTACT } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-sand-200 bg-sand-50/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex shrink-0 items-center gap-3 text-sage-900">
      <Logo class="h-10 w-10 shrink-0" />
      <span class="font-display text-lg leading-tight font-semibold sm:text-xl lg:whitespace-nowrap">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 lg:flex xl:gap-8">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-base font-semibold whitespace-nowrap transition-colors hover:text-sage-700',
              isActive(item.href) ? 'text-sage-700 underline underline-offset-8' : 'text-ink-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden shrink-0 items-center gap-4 lg:flex">
      <a href={CONTACT.phoneHref} class="hidden text-base font-semibold whitespace-nowrap text-sage-700 hover:underline xl:inline">
        {CONTACT.phone}
      </a>
      <a
        href="/contact/"
        class="rounded-full bg-clay-500 px-5 py-2.5 text-base font-semibold whitespace-nowrap text-white transition-colors hover:bg-clay-600"
      >
        Schedule a tour
      </a>
    </div>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="rounded-lg border border-sand-200 bg-white p-2.5 text-sage-900 lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Main"
    hidden
    class="border-t border-sand-200 bg-white lg:hidden"
  >
    <ul class="container-page flex flex-col py-2">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block border-b border-sand-100 py-3.5 text-lg font-semibold text-ink-700"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="flex flex-col gap-3 py-4">
        <a
          href={CONTACT.phoneHref}
          class="text-lg font-semibold text-sage-700"
        >
          Call {CONTACT.phone}
        </a>
        <a
          href="/contact/"
          class="rounded-full bg-clay-500 px-5 py-3 text-center text-lg font-semibold text-white"
        >
          Schedule a tour
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.toggleAttribute('hidden', open);
  });
</script>
