---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle cx="20" cy="20" r="19" class="fill-sage-600" />
  <path
    d="M12 13.5 20 28l8-14.5"
    stroke="currentColor"
    class="text-sand-50"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="20" cy="12" r="2.6" class="fill-clay-100" />
</svg>
