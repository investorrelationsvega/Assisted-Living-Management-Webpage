---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div
  class={`rounded-card border border-sand-200 bg-white p-6 shadow-sm sm:p-8 ${className}`}
>
  <h3 class="text-xl font-semibold">{title}</h3>
  <div class="mt-3 text-ink-500">
    <slot />
  </div>
</div>
