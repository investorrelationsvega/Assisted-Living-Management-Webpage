---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CheckList from '../components/CheckList.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { PRICING, PRICING_INCLUDED, PRICING_EXTRA, FAQS } from '../data/content';
---

<BaseLayout
  title="Pricing"
  description="Transparent monthly pricing for assisted living and memory care at Vega — what is included, what is billed separately, and how the care fee is set."
>
  <PageHero
    eyebrow="Pricing"
    title="What it costs, before you ask twice."
    intro="Monthly rate plus a care fee set by assessment. Both are in the residency agreement before anyone signs anything."
  />

  <Section tone="white">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        PRICING.map((tier) => (
          <div
            class:list={[
              'flex flex-col rounded-card border bg-white p-6 sm:p-8',
              tier.featured
                ? 'border-sage-600 shadow-lg ring-1 ring-sage-600'
                : 'border-sand-200 shadow-sm',
            ]}
          >
            {tier.featured && (
              <p class="mb-3 self-start rounded-full bg-sage-100 px-3 py-1 text-sm font-semibold text-sage-700">
                Most common
              </p>
            )}
            <h2 class="text-2xl font-semibold">{tier.name}</h2>
            <p class="mt-4">
              <span class="font-display text-4xl font-semibold text-sage-900">{tier.rate}</span>
              <span class="ml-2 text-ink-500">{tier.cadence}</span>
            </p>
            <p class="mt-1 text-sm text-ink-500">{tier.note}</p>
            <CheckList class="mt-6 flex-1" items={tier.includes} />
            <Button
              href="/contact/"
              variant={tier.featured ? 'primary' : 'ghost'}
              class="mt-8 w-full"
            >
              Get a written quote
            </Button>
          </div>
        ))
      }
    </div>
    <p class="mt-8 rounded-lg border border-clay-100 bg-clay-100/60 p-4 text-ink-700">
      <strong>Note:</strong> the rates above are placeholders pending the community&rsquo;s published
      rate sheet. Your actual monthly cost depends on the apartment and the care assessment.
    </p>
  </Section>

  <Section>
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="rounded-card border border-sand-200 bg-white p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Included in the monthly rate</h2>
        <CheckList class="mt-5 text-lg" items={PRICING_INCLUDED} />
      </div>
      <div class="rounded-card border border-sand-200 bg-white p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Billed separately</h2>
        <ul class="mt-5 space-y-2.5 text-lg">
          {
            PRICING_EXTRA.map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-clay-500" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="white" eyebrow="Questions" title="Frequently asked">
    <div class="max-w-3xl divide-y divide-sand-200 rounded-card border border-sand-200">
      {
        FAQS.map((faq) => (
          <details class="group p-5 sm:p-6">
            <summary class="cursor-pointer list-none text-lg font-semibold text-sage-900 marker:content-none">
              <span class="flex items-start justify-between gap-4">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-clay-600 transition-transform group-open:rotate-45"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-ink-500">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <CtaBand
    title="Want the real number for your family?"
    body="Bring what you know about your family member’s needs. We will walk through the assessment and put a figure in writing."
  />
</BaseLayout>
