---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { CONTACT } from '../consts';
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <section class="container-page py-24 text-center sm:py-32">
    <p class="text-sm font-semibold tracking-widest text-clay-600 uppercase">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">We couldn&rsquo;t find that page.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink-500">
      The link may be out of date. Head back to the homepage, or call us at{' '}
      <a href={CONTACT.phoneHref} class="font-semibold whitespace-nowrap text-sage-700 hover:underline">
        {CONTACT.phone}
      </a>{' '}
      and we will point you the right way.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button href="/">Back to home</Button>
      <Button href="/contact/" variant="ghost">Contact us</Button>
    </div>
  </section>
</BaseLayout>
