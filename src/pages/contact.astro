---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { CONTACT, FORM_ENDPOINT } from '../consts';
import { CARE_LEVELS } from '../data/content';

const formReady = FORM_ENDPOINT.length > 0;

const fieldClass =
  'mt-2 w-full rounded-lg border border-sand-200 bg-white px-4 py-3 text-base text-ink-900 placeholder:text-ink-500/60 disabled:cursor-not-allowed disabled:bg-sand-100';
const labelClass = 'block text-base font-semibold text-ink-700';
---

<BaseLayout
  title="Contact & Tours"
  description="Schedule a tour of Vega Assisted Living, request an assessment, or ask a question. Tours available daily, including evenings by appointment."
>
  <PageHero
    eyebrow="Contact"
    title="Let’s start with a conversation."
    intro="Call, email, or send the form below. Someone on the care team responds the same business day."
  />

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-semibold">Request a tour</h2>
        <p class="mt-2 text-ink-500">
          Tell us a little about your situation and we will follow up to find a time.
        </p>

        {
          !formReady && (
            <p class="mt-6 rounded-lg border border-clay-100 bg-clay-100/60 p-4 text-ink-700">
              <strong>Form not yet connected.</strong> Set <code>FORM_ENDPOINT</code> in{' '}
              <code>src/consts.ts</code> to a real handler before launch. Until then the fields
              below are disabled so no one submits into a void — please call{' '}
              <a href={CONTACT.phoneHref} class="font-semibold text-sage-700 underline">
                {CONTACT.phone}
              </a>{' '}
              instead.
            </p>
          )
        }

        <form
          method="POST"
          action={formReady ? FORM_ENDPOINT : undefined}
          class="mt-8 space-y-6"
          aria-describedby="privacy-note"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="name">Your name</label>
              <input
                class={fieldClass}
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                disabled={!formReady}
              />
            </div>
            <div>
              <label class={labelClass} for="relationship">Relationship to resident</label>
              <input
                class={fieldClass}
                type="text"
                id="relationship"
                name="relationship"
                placeholder="Daughter, son, spouse, self…"
                disabled={!formReady}
              />
            </div>
            <div>
              <label class={labelClass} for="email">Email</label>
              <input
                class={fieldClass}
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                disabled={!formReady}
              />
            </div>
            <div>
              <label class={labelClass} for="phone">Phone</label>
              <input
                class={fieldClass}
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                disabled={!formReady}
              />
            </div>
          </div>

          <div>
            <label class={labelClass} for="care-level">Level of care you&rsquo;re exploring</label>
            <select class={fieldClass} id="care-level" name="care_level" disabled={!formReady}>
              <option value="">Not sure yet</option>
              {CARE_LEVELS.map((level) => <option value={level.slug}>{level.name}</option>)}
            </select>
          </div>

          <div>
            <label class={labelClass} for="timing">When are you hoping to move?</label>
            <select class={fieldClass} id="timing" name="timing" disabled={!formReady}>
              <option value="">Select a timeframe</option>
              <option value="immediately">As soon as possible</option>
              <option value="1-3-months">In the next 1–3 months</option>
              <option value="3-6-months">In 3–6 months</option>
              <option value="researching">Just researching for now</option>
            </select>
          </div>

          <div>
            <label class={labelClass} for="message">What&rsquo;s going on?</label>
            <textarea
              class={fieldClass}
              id="message"
              name="message"
              rows="5"
              placeholder="A sentence or two about your family member’s situation is plenty."
              disabled={!formReady}></textarea>
          </div>

          <p id="privacy-note" class="rounded-lg bg-sand-100 p-4 text-sm text-ink-500">
            Please keep medical details out of this form — we will collect what we need over the
            phone or in person, where it can be handled properly.
          </p>

          <button
            type="submit"
            disabled={!formReady}
            class="inline-flex items-center justify-center rounded-full bg-sage-600 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-sage-700 disabled:cursor-not-allowed disabled:bg-ink-500/40"
          >
            Send request
          </button>
        </form>
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-card border border-sand-200 bg-sand-50 p-6 sm:p-8">
          <h2 class="text-2xl font-semibold">Reach us directly</h2>
          <dl class="mt-6 space-y-6">
            <div>
              <dt class="text-sm font-semibold tracking-widest text-clay-600 uppercase">Phone</dt>
              <dd class="mt-1">
                <a
                  href={CONTACT.phoneHref}
                  class="font-display text-2xl font-semibold text-sage-700 hover:underline"
                >
                  {CONTACT.phone}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-semibold tracking-widest text-clay-600 uppercase">Email</dt>
              <dd class="mt-1">
                <a href={`mailto:${CONTACT.email}`} class="font-semibold text-sage-700 hover:underline">
                  {CONTACT.email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-semibold tracking-widest text-clay-600 uppercase">Visit</dt>
              <dd class="mt-1">
                <address class="not-italic">
                  {CONTACT.addressLines.map((line) => <div>{line}</div>)}
                </address>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-semibold tracking-widest text-clay-600 uppercase">Office hours</dt>
              <dd class="mt-1">
                {
                  CONTACT.hours.map((slot) => (
                    <div>
                      {slot.days}: {slot.time}
                    </div>
                  ))
                }
              </dd>
            </div>
          </dl>
          <p class="mt-6 border-t border-sand-200 pt-6 text-ink-500">{CONTACT.tourNote}</p>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
